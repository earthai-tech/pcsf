END_X_COORDS
Z_COORDS
5.0
END_Z_COORDS
RESISTIVITY  # linear ohm.m (canonical; spec/pcsf-0.1.md, section 2)
 10.0 100.0
END_RESISTIVITY
OFFSET_Y 0.0
OFFSET_KIND synthetic
LINE_END L0
LINE_BEGIN L1
NX 2
NZ 1
X_COORDS
 0.0 10.0
END_X_COORDS
Z_COORDS
5.0
END_Z_COORDS
RESISTIVITY  # linear ohm.m (canonical; spec/pcsf-0.1.md, section 2)
 10.0 100.0
END_RESISTIVITY
OFFSET_Y 100.0
OFFSET_KIND synthetic
LINE_END L1
DERIVED_VOLUME_BEGIN
NX 2
NY 2
NZ 1
X_COORDS
 0.0 10.0
END_X_COORDS
Y_COORDS
  0.0 100.0
END_Y_COORDS
Z_COORDS
5.0
END_Z_COORDS
