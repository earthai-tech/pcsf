# PCSM -- Portable Common Subsurface Markup (ASCII sibling of a .pcsf file)
PCSM_VERSION 0.1.0
SOURCE_BACKEND generic
CREATED_BY pcsf conformance suite
CREATED_AT 2026-01-01T00:00:00+00:00
RESISTIVITY_UNIT ohm.m

GEOMETRY_KIND multiline
LINE_ORDER L0 L1
LINE_BEGIN L0
NX 3
NZ 2
X_COORDS
  0.0  50.0 100.0
END_X_COORDS
Z_COORDS
 5.0 15.0
END_Z_COORDS
RESISTIVITY  # linear ohm.m (canonical; spec/pcsf-0.1.md, section 2)
  10.0  100.0 1000.0
  20.0  200.0 2000.0
END_RESISTIVITY
OFFSET_Y 0.0
OFFSET_KIND real
LINE_END L0
LINE_BEGIN L1
NX 3
NZ 2
X_COORDS
  0.0  50.0 100.0
END_X_COORDS
Z_COORDS
 5.0 15.0
END_Z_COORDS
RESISTIVITY  # linear ohm.m (canonical; spec/pcsf-0.1.md, section 2)
  20.0  200.0 2000.0
  40.0  400.0 4000.0
END_RESISTIVITY
OFFSET_Y 200.0
OFFSET_KIND real
LINE_END L1
DERIVED_VOLUME_BEGIN
NX 3
NY 2
NZ 2
X_COORDS
  0.0  50.0 100.0
END_X_COORDS
Y_COORDS
  0.0 200.0
END_Y_COORDS
Z_COORDS
 5.0 15.0
END_Z_COORDS
ROTATION_DEG 0.0
N_AIR 0
DV_RESISTIVITY
  10.0  100.0 1000.0
  20.0  200.0 2000.0
  20.0  200.0 2000.0
  40.0  400.0 4000.0
END_DV_RESISTIVITY
DERIVATION_METHOD linear_interp
SYNTHESIZED true
DERIVED_FROM L0 L1
DERIVED_VOLUME_END

